{
  "name": "professionull-presoma",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "bash scripts/setup.sh || true",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tokens": "node scripts/gen-tokens.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "check:design": "node scripts/check-design.mjs",
    "check:tokens": "node scripts/gen-tokens.mjs --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:design && npm run check:tokens && npm run test"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css,md}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
