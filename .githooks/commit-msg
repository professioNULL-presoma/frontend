#!/usr/bin/env bash
# Strip AI-tool attribution lines (co-author trailers naming an AI tool, "Generated with ...").
# Human co-authors are kept.
set -euo pipefail
f="$1"
ai='claude|anthropic|copilot|cursor|openai|chatgpt|gpt-|gemini|codex|devin'
perl -ni -e 'print unless /^\s*co-authored-by:.*('"$ai"')/i || /^\s*(🤖 )?generated (with|by) /i' "$f"
# drop trailing blank lines left behind
perl -0pi -e 's/\n+\z/\n/' "$f"
if ! grep -qE '[^[:space:]#]' "$f"; then echo "✗ empty commit message"; exit 1; fi
