#!/usr/bin/env bash
# Strip contributor/tool-attribution lines, never add any.
set -euo pipefail
f="$1"
sed -i '' -E \
  -e '/^[[:space:]]*(co-authored-by|signed-off-by):/Id' \
  -e '/^[[:space:]]*(🤖 )?generated (with|by) /Id' "$f"
# drop trailing blank lines left behind
perl -0pi -e 's/\n+\z/\n/' "$f"
if ! grep -qE '[^[:space:]#]' "$f"; then echo "✗ empty commit message"; exit 1; fi
